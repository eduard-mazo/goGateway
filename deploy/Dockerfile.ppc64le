# ─── Stage 0: extract CA bundle + timezone data from Alpine ppc64le ──────────
# This stage runs on the build host (x86-64 with binfmt_misc/qemu), not on the
# target.  Its only purpose is to produce the files that FROM scratch cannot
# generate itself.  Nothing from this layer is shipped except those files.
FROM --platform=$BUILDPLATFORM alpine:3.21 AS rootfs
RUN apk add --no-cache ca-certificates tzdata && \
    printf 'nobody:x:65534:65534:nobody:/:/sbin/nologin\n' > /nobody.passwd && \
    printf 'nogroup:x:65534:\n'                             > /nogroup.group

# ─── Final image — FROM scratch, no shell, no package manager ────────────────
FROM scratch

LABEL org.opencontainers.image.title="goGateway" \
      org.opencontainers.image.description="IEC 60870-5-104 / MQTT / TSDB Gateway" \
      org.opencontainers.image.architecture="linux/ppc64le" \
      org.opencontainers.image.licenses="Proprietary"

# TLS trust store — required for outbound HTTPS (VictoriaMetrics, TimescaleDB
# TLS, MQTT over TLS).  The Go TLS stack reads this file directly; no OpenSSL.
COPY --from=rootfs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Timezone database — needed for any time.LoadLocation() call in the pipeline.
COPY --from=rootfs /usr/share/zoneinfo /usr/share/zoneinfo

# Minimal passwd/group — Go's net package resolves "nobody" by reading
# /etc/passwd at runtime when os/user is linked; avoids a numeric-UID fallback
# warning in logs.
COPY --from=rootfs /nobody.passwd /etc/passwd
COPY --from=rootfs /nogroup.group /etc/group

# Pre-built static binary.
# Build on the dev host first: make build-rh-ppc64le
# The binary must be a fully static ELF (CGO_ENABLED=0, no interpreter).
COPY goGateway-linux-ppc64le /usr/local/bin/goGateway

# /data is the single mount point for all mutable state:
#   gateway.db   — SQLite config + measurement history  (GW_DB=/data/gateway.db)
#   wal.bolt     — TSDB write-ahead log                 (configure in UI)
#   dlq.bolt     — TSDB dead-letter queue               (configure in UI)
# WORKDIR creates the directory even in a scratch image.
WORKDIR /data

# HTTP management UI + REST API.
# IEC-104 slave ports are NOT listed here; they are DB-driven and the container
# must run with --network=host (see the companion quadlet file).
EXPOSE 8080

# Run as nobody:nogroup — matches UID/GID 65534 baked in /etc/passwd above.
USER 65534:65534

ENTRYPOINT ["/usr/local/bin/goGateway"]
